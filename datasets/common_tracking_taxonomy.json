{
  "name": "common_tracking_taxonomy",
  "purpose": "Redesigned cross-dataset tracking taxonomy after dropping the previous fixed frame-level anomaly-label assumption.",
  "default_tracking_objects": [
    "person",
    "bicycle"
  ],
  "evidence_only_objects": [
    "bag",
    "backpack",
    "handbag",
    "suitcase",
    "thrown object",
    "paper",
    "box",
    "package",
    "cell phone"
  ],
  "common_anomaly_types": {
    "person_behavior_anomaly": {
      "carrier_targets": [
        "person"
      ],
      "examples": [
        "running",
        "chasing",
        "fighting",
        "falling",
        "loitering",
        "wrong direction",
        "too close",
        "jaywalking",
        "stealing",
        "snatching",
        "protest",
        "group conflict"
      ],
      "evidence_only_objects": [
        "bag",
        "backpack",
        "handbag",
        "suitcase",
        "cell phone"
      ]
    },
    "bicycle_anomaly": {
      "carrier_targets": [
        "bicycle",
        "person"
      ],
      "examples": [
        "bicycle in pedestrian area",
        "cycling on footpath",
        "cycling on square",
        "suddenly stopping cycling",
        "bicycle as abnormal object"
      ]
    },
    "person_object_interaction": {
      "carrier_targets": [
        "person"
      ],
      "examples": [
        "throwing",
        "abandoned bag",
        "forgetting backpack",
        "snatching bag",
        "littering when visible"
      ],
      "evidence_only_objects": [
        "bag",
        "backpack",
        "handbag",
        "suitcase",
        "thrown object",
        "paper",
        "box",
        "package"
      ]
    }
  },
  "dataset_policy": {
    "shanghaitech_test": {
      "tracking_targets": [
        "person",
        "bicycle"
      ],
      "anomaly_types": [
        "person_behavior_anomaly",
        "bicycle_anomaly",
        "person_object_interaction"
      ]
    },
    "avenue_test": {
      "tracking_targets": [
        "person",
        "bicycle"
      ],
      "anomaly_types": [
        "person_behavior_anomaly",
        "bicycle_anomaly",
        "person_object_interaction"
      ]
    },
    "nwpu_test": {
      "tracking_targets": [
        "person",
        "bicycle"
      ],
      "anomaly_types": [
        "person_behavior_anomaly",
        "bicycle_anomaly",
        "person_object_interaction"
      ]
    }
  },
  "excluded_from_common_default": [
    "car",
    "vehicle",
    "motorcycle",
    "bus",
    "truck",
    "dog",
    "skateboard",
    "stroller",
    "cart"
  ]
}
